# ============================================================
# 亚瑟 AX1800 Pro (jdcloud_re-ss-01) 编译配置
# 基于 FanchmWrt snapshot fanchmwrt-26.05
#
# 【设计原则】最小改动、最大成功率
#   本配置只做两件事：
#     1. 选中正确的设备 profile
#     2. 启用 NTFS / exFAT 内核模块 + 固化 NAS 套件
#   其余全部交给 `make defconfig` 自动补全 —— 这样既保证固件
#   功能完整（与原版一致），又避免因手写包名错误导致编译失败。
#
# 【重要】不要写 CONFIG_KERNEL_FUSE_FS 这类选项！
#   OpenWrt 内核文件系统由 kmod 包的 KCONFIG 声明驱动：
#     kmod-fs-ntfs3  -> CONFIG_NTFS3_FS
#     kmod-fs-exfat  -> CONFIG_EXFAT_FS
#   选中 CONFIG_PACKAGE_kmod-xxx=y 即自动生效。
# ============================================================

# ---- 目标平台（必选，其余 defconfig 自动补全） ----
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y
CONFIG_TARGET_MULTI_PROFILE=n
CONFIG_TARGET_ALL_PROFILES=n
CONFIG_TARGET_PER_DEVICE_ROOTFS=n

# ============================================================
# 本次编译的核心：NTFS / exFAT
#   使用内核原生驱动 ntfs3（读写）+ exfat，性能优于 FUSE 方案，
#   因此不启用 kmod-fuse / ntfs-3g，减少依赖链与编译风险。
# ============================================================
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_kmod-nls-cp936=y

# ============================================================
# 存储基础（确保 U 盘/移动硬盘能被识别）
# ============================================================
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_block-mount=y

# ============================================================
# NAS 共享套件（本地自定义包，源码在 package/arthur-nas/）
#   - eMMC 大分区首次开机自动格式化 + 挂载 + Samba 共享
#   - USB/SD 卡热插拔自动挂载 + 自动共享
#   - LuCI 页面: 服务 -> 亚瑟NAS共享
# ============================================================
CONFIG_PACKAGE_arthur-nas=y

# Samba 服务（arthur-nas 依赖它提供共享）
CONFIG_PACKAGE_samba4-server=y
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-i18n-samba4-zh-cn=y
CONFIG_PACKAGE_wsdd2=y

# LuCI 基础（保证 Web 界面与依赖完整）
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-app-opkg=y

# 常用工具
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_curl=y

# ============================================================
# 输出格式
# ============================================================
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_IMAGES_GZIP=y
